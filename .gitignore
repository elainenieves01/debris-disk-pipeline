# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

logs/*
!logs/.gitkeep

config/generated/*
!config/generated/.gitkeep

# Large simulation files
*.bin
*.parquet
*.hdf5
*.h5
*.csv
# ...except the small first/last-snapshot table replot_orbits.py redraws from
!outputs/*/figures/data/orbits_initial_final.csv
# ...and the bodies apply_rayleigh_cut.py left out of each cut
!outputs/*/figures/rayleigh_cut_*/excluded_bodies.csv
# ...and the log of every simulation sent out (src/launch/run_log.py)
!/simulation_log.csv
/.simulation_log.lock

# Per-run checkpoint artifact (dump: true). Now written to outputs/<name>/,
# which is already ignored; this also catches the legacy repo-root location.
dump_data.json

# Keep input folder but avoid committing run tables by accident
inputs/*
!inputs/.gitkeep

# System files
.DS_Store
Thumbs.db
